# Environment Configuration
ENVIRONMENT=development
DEBUG=True
API_PREFIX=/api

# Database Configuration (PostgreSQL)
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://scheduler_user:scheduler_pass@localhost:5432/test_scheduler_db

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# JWT Security Configuration
JWT_SECRET_KEY=change-this-secret-key-in-production-environments-32bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Test Scripts Base Directory
TEST_SCRIPTS_DIR=test_scripts


